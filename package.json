{
  "name": "kenshi-wiki-restoration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-articles.mjs && astro build && node scripts/package.mjs && node scripts/report.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "playwright test",
    "test:catalog": "node --test tests/catalog.test.mjs tests/faction-format.test.mjs tests/race-format.test.mjs tests/gaps.test.mjs tests/warm-move.test.mjs tests/animal-format.test.mjs tests/character-format.test.mjs tests/item-format.test.mjs tests/building-format.test.mjs tests/technology-format.test.mjs tests/shop-format.test.mjs tests/gameplay-format.test.mjs tests/event-format.test.mjs tests/lore-format.test.mjs tests/work-index.test.mjs",
    "package:check": "cf workers versions create --prebuilt --dry-run",
    "inventory": "node scripts/inventory.mjs",
    "report": "node scripts/report.mjs",
    "geography:accept": "node scripts/geography/accept.mjs",
    "review": "node scripts/review.mjs",
    "factions:accept": "node scripts/conversion/accept.mjs factions",
    "races:accept": "node scripts/conversion/accept.mjs races",
    "gaps:normalize": "node scripts/gaps/register.mjs",
    "animals:accept": "node scripts/conversion/accept.mjs animals",
    "characters:accept": "node scripts/conversion/accept.mjs characters",
    "items:accept": "node scripts/conversion/accept.mjs items",
    "buildings:accept": "node scripts/conversion/accept.mjs buildings",
    "crafting:accept": "node scripts/conversion/accept.mjs crafting",
    "technology:accept": "node scripts/conversion/accept.mjs technology",
    "shops:accept": "node scripts/conversion/accept.mjs shops",
    "gameplay:accept": "node scripts/conversion/accept.mjs gameplay",
    "events:accept": "node scripts/conversion/accept.mjs events",
    "lore:accept": "node scripts/conversion/accept.mjs lore",
    "modding:accept": "node scripts/conversion/accept.mjs modding",
    "manufacturers:accept": "node scripts/conversion/accept.mjs manufacturers",
    "remainder:accept": "node scripts/conversion/accept.mjs remainder"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.5",
    "astro": "7.4.7",
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.10",
    "@playwright/test": "1.61.1",
    "cf": "1.0.0-beta.28",
    "miniflare": "5.20261104.0-beta",
    "satteri": "0.11.6",
    "yaml": "2.9.1"
  }
}
