---
import drawings from '../data/glyphs.json';
const { name } = Astro.props;
---
<svg class={'ui-glyph glyph-'+name} width="16" height="16" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true" focusable="false" set:html={drawings[name]} />
