---
// CC BY-SA 3.0 requires naming the source, its authors and the license, and saying the text was changed.
const { title, revision } = Astro.props;
const page = `https://kenshi.fandom.com/wiki/${encodeURIComponent(title.replaceAll(' ', '_'))}`;
---

<div class="notice fandom-notice">
  This article is adapted from <a class="external" href={`${page}?oldid=${revision}`}>{title}</a> on the Kenshi Fandom wiki, written by{' '}
  <a class="external" href={`${page}?action=history`}>its contributors</a> and licensed under{' '}
  <a href="/notices/CC-BY-SA-3.0.txt">CC BY-SA 3.0</a>. It has been converted to Markdown, its images and navigation boxes were left out, and we may have edited it
  since.
</div>
