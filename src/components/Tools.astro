---
import Icon from './Icon.astro';
const { edit, history, compact=false, href } = Astro.props;
---
<button type="button" class="theme-control"><Icon name="sun"/><Icon name="moon"/><span class="theme-caption">Theme</span></button>
<a href={href('/contributors')}><Icon name="people"/>Contributors</a>
<a href={edit}><span class="mask-icon" style="--icon:url('/icons/github.svg')" aria-hidden="true"></span>Edit on GitHub</a>
{compact && <><a href="https://github.com/mattresspad/kenshi-wiki/commits/main/"><Icon name="pulse"/>Recent changes</a>
<a href={history}><Icon name="clock"/>View history</a></>}
