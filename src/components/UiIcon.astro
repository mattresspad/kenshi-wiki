---
export type IconName = 'home' | 'dice' | 'people' | 'pulse' | 'clock' | 'sun' | 'moon';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class:list={['ui-icon', className]} data-icon={name} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'home' && <path d="m3 11 9-8 9 8M5.5 9v11h4.25v-6h4.5v6h4.25V9" />}
  {name === 'dice' && <>
    <rect x="3.5" y="3.5" width="17" height="17" rx="2" />
    <path d="M7.5 7.5h.01m8.99 0h.01M12 12h.01M7.5 16.5h.01m8.99 0h.01" stroke-width="2.8" />
  </>}
  {name === 'people' && <>
    <circle cx="12" cy="7" r="2.5" />
    <path d="M7.5 20v-3.5a4.5 4.5 0 0 1 9 0V20M6.5 5.5a2.5 2.5 0 1 0 0 5M17.5 5.5a2.5 2.5 0 1 1 0 5M5 13.5a4 4 0 0 0-3 4V20m17-6.5a4 4 0 0 1 3 4V20" />
  </>}
  {name === 'pulse' && <path d="M2 12h5l3-8 4 16 3-8h5" />}
  {name === 'clock' && <>
    <circle cx="12" cy="12" r="9" />
    <path d="M12 6.5V12l4 2.5" />
  </>}
  {name === 'sun' && <>
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
  </>}
  {name === 'moon' && <path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z" />}
</svg>
