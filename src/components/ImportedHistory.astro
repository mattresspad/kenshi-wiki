---
const {article} = Astro.props;
const original = article.source === 'original';
const fandom = original ? null : 'https://kenshi.fandom.com/wiki/' + encodeURIComponent(article.source.title.replaceAll(' ', '_'));
const originalFile = 'https://github.com/mattresspad/kenshi-wiki/blob/' + article.originalCommit + '/' + article.sourceFile;
---
<section lang="en" class="import-history" aria-labelledby="source-history">
  <h2 id="source-history" tabindex="-1">Sources and history</h2>
  {original ? <p>Written by {article.credit}, under <a href={'https://creativecommons.org/licenses/by-sa/' + article.license + '/'}>CC BY-SA {article.license}</a>. <a href={originalFile}>Original guide or article revision</a>.</p> :
  <p>Adapted from <a href={fandom + '?oldid=' + article.source.revision}>{article.source.title}, revision {article.source.revision}</a>,
    by <a href={fandom + '?action=history'}>{article.credit}</a>, under <a href={'https://creativecommons.org/licenses/by-sa/' + article.license + '/'}>CC BY-SA {article.license}</a>.</p>}
</section>
