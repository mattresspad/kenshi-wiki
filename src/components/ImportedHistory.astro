---
const {article} = Astro.props;
const fandom = 'https://kenshi.fandom.com/wiki/' + encodeURIComponent(article.source.title.replaceAll(' ', '_'));
---
<section class="import-history" aria-labelledby="source-history">
  <h2 id="source-history" tabindex="-1">Sources and history</h2>
  <p>Adapted from <a href={fandom + '?oldid=' + article.source.revision}>{article.source.title}, revision {article.source.revision}</a>,
    by <a href={fandom + '?action=history'}>{article.credit}</a>, under <a href={'https://creativecommons.org/licenses/by-sa/' + article.license + '/'}>CC BY-SA {article.license}</a>.</p>
</section>
