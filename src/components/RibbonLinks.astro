---
interface Props {
  links: { label: string; href: string; image?: string; glyph?: string; iconOnly?: boolean }[];
}
const { links } = Astro.props;
---
{links.map(({ label, href, image, glyph, iconOnly }) => (
  <a class="ribbon-link" href={href} title={iconOnly ? label : undefined}>
    {image && <img src={`/ribbon-icons/${image}.webp`} alt={iconOnly ? label : ''} width="16" height="16" />}
    {glyph && <span class="ribbon-glyph" aria-hidden="true" style={`--glyph: url('/ribbon-icons/${glyph}.svg')`} />}
    {!iconOnly && <span>{label}</span>}
  </a>
))}
