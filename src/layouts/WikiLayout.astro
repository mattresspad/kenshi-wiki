---
import '../styles/global.css';
import '../styles/wiki-header.css';
import type { ComponentProps } from 'astro/types';
import WikiHeader from '../components/WikiHeader.astro';
import WikiNavigation from '../components/WikiNavigation.astro';
import { wiki } from '../lib/wiki.js';

interface Props {
  title: string;
  description: string;
  source: string;
  kind?: ComponentProps<typeof WikiHeader>['page']['kind'];
  categories?: string[];
  outline?: ComponentProps<typeof WikiNavigation>['outline'];
  searchable?: boolean;
  showTitle?: boolean;
  leadingInfobox?: boolean;
}
const { title, description, source, outline, categories = [], kind = 'utility', searchable = true, showTitle = false, leadingInfobox = false } = Astro.props;
const heading = kind === 'category' ? `Category:${title}` : title;
const pageClass = `page-${heading.replaceAll(' ', '_')}`;
const page = {
  kind, title,
  href: kind === 'home' ? '/' : Astro.url.pathname.replace(/(?:\.html|\/)$/, '') || '/',
  categories: categories.toSorted((a, b) => a.localeCompare(b, 'en', { sensitivity: 'base' })).map(name => ({ name, href: wiki(`Category:${name}`) })),
};
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{kind === 'home' ? 'Kenshi Wiki' : `${heading} - Kenshi Wiki`}</title>
    <meta name="description" content={description} />
    <script is:inline>
      document.documentElement.dataset.navigation = 'open';
      try {
        if (localStorage.getItem('wiki-navigation') === 'closed') document.documentElement.dataset.navigation = 'closed';
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : 'auto';
      } catch {
        document.documentElement.dataset.theme = 'auto';
      }
    </script>
  </head>
  <body class={`mediawiki ltr sitedir-ltr ns-0 ns-subject ${pageClass} skin-vector action-view skin-vector-legacy`}>
    <a class="reader-skip" href="#content">Skip to content</a>
    <WikiHeader {page} {source} />
    <WikiNavigation href={page.href} {outline} />
    <main id="content" class:list={['mw-body', { 'has-leading-infobox': leadingInfobox }]} tabindex="0" aria-label="Wiki content" data-pagefind-body={searchable ? '' : undefined}>
      <h1 id="firstHeading" class="firstHeading" style={showTitle ? 'display: block' : undefined}>{heading}</h1>
      <div id="bodyContent" class="mw-body-content">
        <div id="mw-content-text" class="mw-content-ltr">
          <div class="mw-parser-output">
            <slot />
          </div>
        </div>

        {kind === 'article' && page.categories.length > 0 && (
          <div id="catlinks" class="catlinks">
            <div id="mw-normal-catlinks" class="mw-normal-catlinks">
              {categories.length === 1 ? 'Category' : 'Categories'}:{' '}
              <ul>
                {page.categories.map(({ name, href }) => (
                  <li><a href={href}>{name}</a></li>
                ))}
              </ul>
            </div>
          </div>
        )}
      </div>
    </main>

    <footer id="footer" class="mw-footer reader-footer">
      <div class="footer-licenses">
        <span>Original text — <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></span>
        <span>Fandom adaptations — <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a></span>
      </div>
      <span>Fan-made wiki. Kenshi is a trademark of Lo-Fi Games.</span>
      <nav aria-label="Licensing and artwork">
        <a href="/contributors#licensing">Licensing</a>
        <a href="/contributors#artwork">Artwork notices</a>
      </nav>
    </footer>

    <script>
      import { setUpSortableTables } from '../lib/sortable-tables';

      setUpSortableTables();

      // Browsers restore the document scroll on Back. The desktop article has its own scrollport.
      const article = document.querySelector<HTMLElement>('main#content')!;
      function rememberPosition() {
        if (getComputedStyle(article).overflowY === 'auto' && history.state?.articleTop !== article.scrollTop) {
          history.replaceState({ ...history.state, articleTop: article.scrollTop }, '');
        }
      }
      function restorePosition() {
        const top = history.state?.articleTop;
        if (typeof top === 'number' && getComputedStyle(article).overflowY === 'auto') {
          requestAnimationFrame(() => { article.scrollTop = top; });
        }
      }
      // Sidebar jumps also leave a history entry in this scrollport.
      document.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a[href^="#"]')) rememberPosition();
      });
      article.addEventListener('scrollend', rememberPosition);
      window.addEventListener('pagehide', rememberPosition);
      window.addEventListener('pageshow', restorePosition);
      window.addEventListener('popstate', restorePosition);
    </script>
  </body>
</html>
