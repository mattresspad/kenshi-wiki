---
import UtilityArticle from '../components/UtilityArticle.astro';
import {activeUtilityPaths,proseUtilities} from '../lib/utility-routes.mjs';
export function getStaticPaths(){return proseUtilities.filter(p=>activeUtilityPaths.includes(p.path)).map(p=>({params:{utility:p.id},props:{pageId:p.id}}));}
---
<UtilityArticle pageId={Astro.props.pageId}/>
