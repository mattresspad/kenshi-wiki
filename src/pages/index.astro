---
import WikiLayout from '../layouts/WikiLayout.astro';
import { developmentUrl, repoUrl, wiki } from '../lib/wiki.js';
import { existingPaths } from '../lib/categories.js';

// Each card heads with a hub page and lists links as 'Title' or ['Label', 'Title']; a title may be a 'Category:'.
// image names a picture in public/images/kenshi/main-page/, a screenshot or a cutout game icon; a card without one
// shows its emoji icon.
const sections = [
  {
    title: 'Concepts',
    cards: [
      { title: 'Basics', image: 'basics.webp', icon: '📖', page: 'Controls', links: ['Controls', 'Game Starts', ['Skills', 'Statistics'], ['Lore', 'Category:Lore'], ['Guides', 'Category:Guides'], ['Events', 'Category:Events']] },
      { title: 'Gameplay', image: 'gameplay.webp', icon: '🎒', page: 'Statistics', links: ['Stealth', 'Thievery', 'Assassination', 'Bounty', 'Slavery', ['Money', 'Cats']] },
      { title: 'Extras', image: 'extras.webp', icon: '🛠️', page: 'Mods', links: ['Mods', 'Forgotten Construction Set', ['Modding', 'Category:Modding'], ['Modding guides', 'Category:Modding Guide'], ['Removed content', 'Category:Removed Content']] },
      { title: 'Skills', image: 'skills.webp', icon: '⚔️', page: 'Statistics', links: ['Martial Arts', 'Strength', 'Dexterity', 'Toughness', 'Athletics', 'Swimming'] },
      { title: 'World', image: 'world.webp', icon: '🌍', page: 'World of Kenshi', links: [['Map', 'World of Kenshi'], 'Major Towns', ['Zones', 'Category:Zones'], ['Locations', 'Category:Locations'], 'Ancient Ruins', 'World States'] },
    ],
  },
  {
    title: 'Items',
    cards: [
      { title: 'Gear', image: 'gear.png', cutout: true, icon: '🗡️', page: 'Equipment', links: ['Weapons', 'Armour', 'Clothing', 'Backpacks', 'Robot Limbs', ['Crossbows', 'Category:Crossbows']] },
      { title: 'Armour', image: 'armour.png', cutout: true, icon: '🛡️', page: 'Armour', links: ['Light Armour', 'Medium Armour', 'Heavy Armour', 'Headgear', 'Body Armour', 'Shirts', 'Legwear', 'Footwear'] },
      { title: 'Resources', image: 'resources.webp', icon: '📦', page: 'Items', links: ['Items', 'Food', ['Nutrition', 'Category:Nutrition'], ['Books', 'Book'], 'Artifacts', 'AI Core'] },
      { title: 'Technology', image: 'technology.webp', icon: '⚙️', page: 'Technology', links: ['Technology', 'Blueprints', 'Robotics', 'Crafting', 'Cooking'] },
      {
        title: 'Building',
        image: 'building.webp',
        icon: '🏚️',
        page: 'Construction',
        links: [['Construction', 'Construction'], ['Buildings', 'Category:Buildings'], 'Farming', 'Power', 'Storage', 'Turrets', 'Water', 'Copper'],
      },
    ],
  },
  {
    title: 'Life',
    cards: [
      {
        title: 'Characters',
        image: 'characters.webp',
        icon: '🧍',
        page: 'Category:Characters',
        links: [['All characters', 'Category:Characters'], ['Unique NPCs', 'Category:Unique'], ['Bosses', 'Category:Bosses'], 'Traders', ['Vendors', 'Category:Vendors'], ['Nobles', 'Category:Nobles']],
      },
      { title: 'Races', image: 'races.webp', icon: '🧬', page: 'Races', links: ['Greenlander', 'Scorchlander', 'Shek', 'Hive', 'Skeleton'] },
      { title: 'Factions', image: 'factions.webp', icon: '🏳️', page: 'Factions', links: ['The Holy Nation', 'United Cities', 'Shek Kingdom', 'Tech Hunters', 'Shinobi Thieves', 'Slave Traders'] },
      { title: 'Fauna', image: 'fauna.webp', icon: '🦎', page: 'Fauna', links: ['Fauna', ['Animals', 'Category:Animals'], 'Wildlife'] },
    ],
  },
];

// Links resolve against the pages the site builds; one that no longer resolves is dropped, with a warning.
const existing = await existingPaths();
function resolve(link) {
  const [label, title] = Array.isArray(link) ? link : [link, link];
  if (existing.has(wiki(title))) return { label, href: wiki(title) };
  console.warn(`Main page: "${title}" is not a page; its link is left out.`);
  return null;
}

const resolved = sections.map((section) => ({
  ...section,
  cards: section.cards.map((card) => ({ ...card, href: resolve(card.page)?.href, links: card.links.map(resolve).filter(Boolean) })),
}));

---

<WikiLayout
  title="Main Page"
  description="The community wiki for Kenshi, the open-world squad-based RPG by Lo-Fi Games."
  source="src/pages/index.astro"
  categories={['Kenshi Wiki']}
  mainPage
>
  <div class="home-intro">
    <a href="/" aria-label="Kenshi Wiki main page">
      <img class="home-wordmark" src="/kenshi-wordmark.png" alt="Kenshi" width="400" height="187" />
    </a>
    <div>
      <p>
        <strong><a href="https://store.steampowered.com/app/233860/Kenshi/">Kenshi</a></strong> is an open-world, squad-based RPG by{' '}
        <a href={developmentUrl}>Lo-Fi Games</a>, the studio founded by <a href={developmentUrl}>Chris Hunt</a>.
      </p>
      <nav aria-label="About the game and wiki">
        <ul class="home-quick-links">
          <li><a href={wiki('About Kenshi')}>About Kenshi</a></li>
          <li><a href={wiki('Category:Guides')}>Guides</a></li>
          <li><a href="https://store.steampowered.com/news/app/233860">Patch notes</a></li>
          <li><a href={`${repoUrl}#contributing`}>Contribute</a></li>
        </ul>
      </nav>
    </div>
  </div>

  <nav class="home-directory" aria-label="Browse wiki topics">
    <div class="home-sections">
      {resolved.map((section) => (
        <section aria-labelledby={section.title}>
          <h2 id={section.title}>{section.title}</h2>
          <div class="directory-groups">
            {section.cards.map((card) => (
              <div class="directory-group">
                {card.image ? (
                  <img class:list={['directory-thumb', { cutout: card.cutout }]} src={`/images/kenshi/main-page/${card.image}`}
                    width="64" height="64" alt="" loading="lazy" />
                ) : (
                  <span class="directory-thumb" aria-hidden="true">{card.icon}</span>
                )}
                <div>
                  <h3>{card.href ? <a href={card.href}>{card.title}</a> : card.title}</h3>
                  <ul>
                    {card.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </nav>
</WikiLayout>
