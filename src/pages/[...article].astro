---
import Frame from '../layouts/Frame.astro';
import {readWiki} from '../lib/wiki';
import {categoryPath, displayCategories, origin, repo, snapshot} from '../lib/catalog.mjs';
import {prepareArticle} from '../lib/article.mjs';
export async function getStaticPaths() {
  const {entries} = await readWiki();
  return entries.map(entry=>({params:{article:entry.id},props:{entry}}));
}
const {entry}=Astro.props;
const {href}=await readWiki();
const data=entry.data;
const {intro,body,outline}=prepareArticle(entry.rendered?.html,data,href);
const categories=displayCategories(data.categories);
const source='src/content/wiki/'+entry.id+'.md';
const history=repo+'/commits/'+snapshot.revision+'/'+source;
const edit=repo+'/edit/main/'+source;
const correction=new URL(repo+'/issues/new');
correction.search=new URLSearchParams({template:'article-correction.yml',article:origin+'/'+entry.id}).toString();
---
<Frame kind="article" publicPath={'/'+entry.id} title={data.title} description={data.description} {categories} {outline} {href} {edit} {history}>
  <div id="content" class:list={['article-sheet',data.layout,{'with-facts':data.facts}]}><article id="bodyContent" aria-labelledby="firstHeading">
    <div class="opening">
      <header class="article-head"><h1 id="firstHeading" tabindex="-1">{data.title}</h1></header>
      <div class="opening-copy">
        {data.versions && <div class="tested-versions"><span>Tested with</span>{data.versions.map(([label,url])=><a href={url}>{label}</a>)}</div>}
        <div class="lead-text" set:html={intro}/>
        <nav class="article-actions" aria-label="Article sources and corrections"><a href="#source-history">Sources and history</a><a href={correction.href}>Suggest a correction</a>
        {data.layout==='recipe' && <a href="#turn-save-and-reload">Jump to the player test</a>}</nav>
      </div>
      {data.facts && <aside class="factbox" aria-label={data.title+' facts'}>
        <h2>{data.title}</h2><dl>{data.facts.map(([key,...parts])=><><dt>{key}</dt><dd>{parts.map(part=>Array.isArray(part)?<a href={href(part[1])}>{part[0]}</a>:part)}</dd></>)}</dl>
        {data.recordId && <><h3>Technical info</h3><dl><dt>Town ID</dt><dd><code>{data.recordId}</code></dd></dl></>}
      </aside>}
    </div>
    <div id="mw-content-text" class="article-body" set:html={body}/>
    <div class="source-links"><a href={repo+'/blob/'+(data.sourceRevision ?? snapshot.revision)+'/'+source}>Recorded Markdown</a><a href={history}>Article revision history</a><a href={correction.href}>Suggest a correction to this article</a></div>
    <nav id="catlinks" class="end-categories" aria-label="Page categories"><span id="mw-normal-catlinks">{categories.length===1?'Category':'Categories'}</span>
      {categories.map(name=><a href={href(categoryPath(name))}>{name}</a>)}</nav>
  </article></div>
  <script>import '../scripts/sort-table.js';</script>
</Frame>
