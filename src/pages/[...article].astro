---
import GeographyFacts from '../components/GeographyFacts.astro';
import ImportedHistory from '../components/ImportedHistory.astro';
import Frame from '../layouts/Frame.astro';
import {readWiki} from '../lib/wiki';
import {categoryPath, displayCategories, origin, snapshot} from '../lib/catalog.mjs';
import {recordedSource, correctionLink} from '../lib/page-source.mjs';
import {prepareArticle} from '../lib/article.mjs';
export async function getStaticPaths() {
  const {entries, byId} = await readWiki();
  return entries.map(entry => {
    const article = byId.get(entry.data.articleId);
    return {params:{article:article.path.slice(1)}, props:{entry, article}};
  });
}
const {entry,article}=Astro.props;
const {href}=await readWiki();
const data=entry.data;
const {intro,body,outline,buildingPanel}=prepareArticle(entry.rendered?.html,data,href);
const importedGeography = ['geography','faction','race','animal','character','item','building'].includes(data.layout);
if (importedGeography) outline.push({id:'source-history', label:'Sources and history', children:[]});
const categories=displayCategories(data.categories);
const source=recordedSource(article.sourceFile, article.sourceRevision, snapshot.revision);
const history=source.history;
const correction=correctionLink(origin+article.path);
---
<Frame kind="article" publicPath={article.path} title={data.title} description={data.description} {categories} {outline} {href} editableFile={article.filePath} {history}>
  <div id="content" class:list={['article-sheet',data.layout,{'with-facts':data.facts || data.factGroups || buildingPanel, imported:importedGeography}]}><article id="bodyContent" data-article-id={article.id} aria-labelledby="firstHeading">
    <div class="opening">
      <header class="article-head"><h1 id="firstHeading" tabindex="-1">{data.title}</h1></header>
      <div class="opening-copy">
        {data.versions && <div class="tested-versions"><span>Tested with</span>{data.versions.map(([label,url])=><a href={url}>{label}</a>)}</div>}
        <div class="lead-text" set:html={intro}/>
        <nav class="article-actions" aria-label="Article sources and corrections"><a href="#source-history">Sources and history</a><a href={correction}>Suggest a correction</a>
        {data.layout==='recipe' && <a href="#turn-save-and-reload">Jump to the player test</a>}</nav>
      </div>
      {buildingPanel && <aside class="building-facts" aria-label={data.title+' building properties'} set:html={buildingPanel}/>}
      {data.factGroups && <GeographyFacts title={data.factTitle ?? data.title} groups={data.factGroups} image={data.factImage} caption={data.factCaption} {href}/>}
      {data.facts && <aside class="factbox" aria-label={data.title+' facts'}>
        <h2>{data.title}</h2><dl>{data.facts.map(([key,...parts])=><><dt>{key}</dt><dd>{parts.map(part=>Array.isArray(part)?<a href={href(part[1])}>{part[0]}</a>:part)}</dd></>)}</dl>
        {data.recordId && <><h3>Technical info</h3><dl><dt>Town ID</dt><dd><code>{data.recordId}</code></dd></dl></>}
      </aside>}
    </div>
    <div id="mw-content-text" class="article-body" set:html={body}/>
    {importedGeography && <ImportedHistory {article}/>}
    <div class="source-links"><a href={source.markdown}>Recorded Markdown</a><a href={history}>Article revision history</a><a href={correction}>Suggest a correction to this article</a></div>
    <nav id="catlinks" class="end-categories" aria-label="Page categories"><span id="mw-normal-catlinks">{categories.length ? (categories.length===1?'Category':'Categories') : ''}</span>
      {categories.map(name=><a href={href(categoryPath(name))}>{name}</a>)}</nav>
  </article></div>
  <script>import '../scripts/sort-table.js';</script>
</Frame>
